{
  "name": "manga-translator",
  "version": "1.0.0",
  "private": true,
  "description": "Chromium MV3 manga translator extension (WXT, Svelte, ONNX Runtime Web)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "postinstall": "wxt prepare",
    "dev": "wxt",
    "prebuild": "npm run models:verify",
    "build": "wxt build",
    "prezip": "npm run models:verify",
    "zip": "wxt zip",
    "typecheck": "wxt prepare && svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test -c tests/e2e/playwright.config.ts",
    "models:setup": "node scripts/setup-models.mjs",
    "models:verify": "node scripts/verify-models.mjs",
    "verify:ort": "node scripts/verify-ort-assets.mjs",
    "verify:build": "node scripts/verify-build.mjs"
  },
  "dependencies": {
    "onnxruntime-web": "1.31.1",
    "svelte": "5.58.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/chrome": "0.3.7",
    "@types/node": "22.20.5",
    "@wxt-dev/module-svelte": "2.0.5",
    "eslint": "10.15.0",
    "eslint-plugin-svelte": "3.24.1",
    "globals": "17.14.0",
    "svelte-check": "4.7.8",
    "svelte-eslint-parser": "1.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.1",
    "wxt": "0.21.5"
  }
}
