{
  "extends": "./.wxt/tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUncheckedIndexedAccess": false,
    "skipLibCheck": true,
    "types": ["chrome", "svelte", "node"]
  },
  "include": [
    "src/**/*",
    "tests/**/*",
    "scripts/**/*",
    "wxt.config.ts",
    "vitest.config.ts",
    "eslint.config.js",
    ".wxt/wxt.d.ts"
  ]
}
